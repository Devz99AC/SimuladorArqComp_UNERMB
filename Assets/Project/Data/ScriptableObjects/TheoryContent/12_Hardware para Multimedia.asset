  m_Script: {fileID: 11500000, guid: 369837c42b7239f439a0e49ed4ae0504, type: 3}
  m_Name: 12_Hardware para Multimedia
  m_EditorClassIdentifier: 
  title: Hardware para Multimedia
  contentText: "El hardware para multimedia incluye componentes como la tarjeta de
    sonido, tarjeta gr\xE1fica, tarjeta de video y monitores, que se encargan del
    audio y video, junto con dispositivos de entrada y salida como c\xE1maras web,
    micr\xF3fonos, altavoces, auriculares, teclados y ratones para interactuar con
    el contenido multimedia. Tambi\xE9n requiere almacenamiento adecuado, como discos
    duros o SSD, y un procesador potente para manejar el procesamiento de datos. "
  topicImage: {fileID: 21300000, guid: c661b874bf1409c4a8d7267d5639927d, type: 3}
