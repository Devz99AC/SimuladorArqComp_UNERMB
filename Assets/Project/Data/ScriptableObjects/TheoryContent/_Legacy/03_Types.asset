  m_Script: {fileID: 11500000, guid: 369837c42b7239f439a0e49ed4ae0504, type: 3}
  m_Name: 03_Types
  m_EditorClassIdentifier: 
  title: Tipos de Computadora
  contentText: "Las computadoras se pueden clasificar principalmente seg\xFAn su
    forma de procesamiento (anal\xF3gicas, digitales e h\xEDbridas) o por su tama\xF1o
    y capacidad (supercomputadoras, mainframes, minicomputadoras, microcomputadoras).
    Dentro de las microcomputadoras, existen tipos como computadoras de escritorio,
    port\xE1tiles, tabletas y tel\xE9fonos inteligentes. "
  topicImage: {fileID: 21300000, guid: 6623d5eb3b32ce94ba86d0ea579d2425, type: 3}
