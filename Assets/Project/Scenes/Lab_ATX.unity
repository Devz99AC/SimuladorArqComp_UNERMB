  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PCPart
  isDraggable: 0
  partName: Gabinete
  connectionType: {fileID: 0}
  title: Gabinete ATX (torre media)
  description: "Es la carcasa que protege y sujeta todos los componentes. Aqu\xED est\xE1 tumbado y sin el panel lateral, como se hace al armar un equipo. Por dentro tiene la bandeja de la placa base con sus separadores, el hueco de la fuente (abajo y al fondo), la bah\xEDa del disco y los ventiladores, que meten aire fresco por el frente y lo sacan por detr\xE1s."
  startInstalledIn: {fileID: 0}
  restPoint: {fileID: 0}
