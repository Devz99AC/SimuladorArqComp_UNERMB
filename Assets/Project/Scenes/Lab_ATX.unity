  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PCPart
  isDraggable: 1
  partName: PlacaBase
  connectionType: {fileID: 11400000, guid: fe2064d6a41fa9b40843b7092bed0702, type: 2}
  title: Placa base ATX (ASUS ROG Strix Z370-E)
  description: "Es el circuito principal: conecta el procesador, la memoria, el almacenamiento y las tarjetas de expansi\xF3n. Formato ATX (30,5 \xD7 24,4 cm), socket LGA 1151 para procesadores Intel, cuatro ranuras DDR4 y dos ranuras M.2. Conviene instalarle el procesador, el disipador y la memoria fuera del gabinete, donde hay espacio."
