  victoryTitle: "\xA1MANTENIMIENTO COMPLETADO!"
  victoryText: "La laptop qued\xF3 cerrada y lista: memoria en doble canal, SSD nuevo, Wi-Fi y touchpad reconectados, y la bater\xEDa conectada al final, con todo en su sitio."
  maxErrorLines: 6
