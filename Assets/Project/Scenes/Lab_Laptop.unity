  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PCPart
  isDraggable: 1
  partName: 'Conector: Antena auxiliar (cable negro)'
  connectionType: {fileID: 11400000, guid: 1fc41297a8374da40839ea4afe6e95fe, type: 2}
  title: Antena auxiliar (cable negro)
  description: "Cable coaxial fino (1,13 mm) que viene de la antena, en el marco de la pantalla, y pasa por la bisagra. La tarjeta tiene dos terminales: MAIN (principal, tri\xE1ngulo blanco) y AUX (auxiliar, tri\xE1ngulo negro). Aqu\xED el blanco va a MAIN y el negro a AUX: es la convenci\xF3n de otros manuales de Dell (el del 5400 no indica los colores), as\xED que en un equipo real se comprueban los tri\xE1ngulos de la tarjeta. Se conecta presionando recto hasta el clic y se desconecta tirando recto hacia arriba, sin palanca."
  explainWrongPlace: 1
  startInstalledIn: {fileID: 1351998980}
  restPoint: {fileID: 1411767327}
